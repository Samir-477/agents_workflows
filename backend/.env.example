# Copy this file to .env for local development. Never commit real credentials.

# Shared by every model-powered agent. Legacy SEO_AUDIT_LLM_* names remain supported.
AGENT_LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-local-groq-key
AGENT_LLM_MODEL=qwen/qwen3.6-27b

# Optional OpenAI alternative:
# AGENT_LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-with-a-supported-openai-key
# AGENT_LLM_MODEL=replace-with-a-supported-openai-model-id

# Required locally and in Vercel. Use Supabase's transaction pooler on port 6543.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres
SEO_AUDIT_REPORTS_DIR=reports
SEO_AUDIT_DEFAULT_CRAWL_LIMIT=20
SEO_AUDIT_MAX_CRAWL_LIMIT=100
SEO_AUDIT_REQUEST_TIMEOUT=12
SEO_AUDIT_CRAWL_DELAY=0.15
SEO_AUDIT_WORKER_POLL_SECONDS=1
SEO_AUDIT_ALLOW_PRIVATE_NETWORKS=false
SEO_AUDIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional for Vercel preview domains (regex syntax):
# SEO_AUDIT_CORS_ORIGIN_REGEX=https://stellar-frontend-.*\.vercel\.app
