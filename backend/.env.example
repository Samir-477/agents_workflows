# Copy this file to .env and fill in your local values.
# Never commit a real API key.

SEO_AUDIT_LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-local-groq-key
SEO_AUDIT_LLM_MODEL=openai/gpt-oss-20b

# Optional OpenAI alternative:
# SEO_AUDIT_LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-local-openai-key
# SEO_AUDIT_LLM_MODEL=replace-with-a-supported-openai-model-id

SEO_AUDIT_DATABASE=data/audits.sqlite3
# Production on Vercel: paste Supabase's transaction-pooler URI (port 6543).
# Keep this value in Vercel's backend project only.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres
SEO_AUDIT_REPORTS_DIR=reports
SEO_AUDIT_DEFAULT_CRAWL_LIMIT=20
SEO_AUDIT_MAX_CRAWL_LIMIT=100
SEO_AUDIT_REQUEST_TIMEOUT=12
SEO_AUDIT_CRAWL_DELAY=0.15
SEO_AUDIT_WORKER_POLL_SECONDS=1
SEO_AUDIT_ALLOW_PRIVATE_NETWORKS=false
SEO_AUDIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
